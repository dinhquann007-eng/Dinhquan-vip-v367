local Ignore={"quest","mission","chest","treasure","reward","npc","shop","merchant"}
local function HasWord(obj,list)
 local p=obj
 for _=1,6 do
  if not p then break end
  local n=string.lower(p.Name)
  for _,w in ipairs(list) do if string.find(n,w,1,true) then return true end end
  p=p.Parent
 end
 return false
end
local function IsVFX(obj)
 if not obj or not obj.Parent or obj:IsDescendantOf(Gui) or HasWord(obj,Ignore) then return false end
 if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then return HasWord(obj,Words) end
 return false
end
local function Apply(obj)
 if not Enabled or not IsVFX(obj) then return end
 pcall(function()
  local old=obj.Color; local keys={}
  for _,k in ipairs(old.Keypoints) do keys[#keys+1]=ColorSequenceKeypoint.new(k.Time,Color) end
  obj.Color=ColorSequence.new(keys)
  if obj:IsA("ParticleEmitter") and Neon then obj.LightEmission=math.max(obj.LightEmission,.35) end
 end)
end
