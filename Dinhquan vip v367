--============================================================
-- LOADING ANIMATION
--============================================================

local steps = {
    {0.20, "Loading interface..."},
    {0.40, "Preparing modules..."},
    {0.60, "Optimizing..."},
    {0.80, "Loading components..."},
    {1.00, "Ready!"}
}

for _, step in ipairs(steps) do
    local target = step[1]
    local text = step[2]

    Status.Text = text

    local tween = TweenService:Create(
        Bar,
        TweenInfo.new(
            LoadingTime / #steps,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.fromScale(target, 1)
        }
    )

    tween:Play()

    local start = Bar.Size.X.Scale
    local duration = LoadingTime / #steps
    local elapsed = 0

    while elapsed < duration do
        elapsed += task.wait()

        local alpha = math.clamp(elapsed / duration, 0, 1)
        local value = start + (target - start) * alpha
        Percent.Text = tostring(math.floor(value * 100)) .. "%"
    end

    Percent.Text = tostring(math.floor(target * 100)) .. "%"
end

--============================================================
-- CLOSE
--============================================================

task.wait(0.25)

local fadeInfo = TweenInfo.new(
    0.35,
    Enum.EasingStyle.Quad,
    Enum.EasingDirection.Out
)

TweenService:Create(Main, fadeInfo, {
    BackgroundTransparency = 1
}):Play()

TweenService:Create(Overlay, fadeInfo, {
    BackgroundTransparency = 1
}):Play()

for _, obj in ipairs(Main:GetDescendants()) do
    if obj:IsA("TextLabel") then
        TweenService:Create(obj, fadeInfo, {
            TextTransparency = 1,
            TextStrokeTransparency = 1
        }):Play()
    elseif obj:IsA("UIStroke") then
        TweenService:Create(obj, fadeInfo, {
            Transparency = 1
        }):Play()
    elseif obj:IsA("Frame") then
        TweenService:Create(obj, fadeInfo, {
            BackgroundTransparency = 1
        }):Play()
    end
end

task.wait(0.4)

